# copy this file to .env and fill in your own values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=islamabad_health_gis
DB_USER=postgres
DB_PASSWORD=your_postgres_password

PORT=3000

# password that editors type on the website to add / edit records
EDITOR_PASSWORD=change_this_password
# any long random text, used to sign the login token
TOKEN_SECRET=change_this_to_a_long_random_string
